<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>human_tracking</name>
  <version>1.0.0</version>
  <description>Real-time human pose and hand tracking for robot teleoperation using MediaPipe</description>
  <maintainer email="electrospin@platform.dev">ElectroSpin Platform</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>electrospin_interfaces</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-cv-bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
