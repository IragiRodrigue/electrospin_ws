Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Cell Size: 0.1
      Color: 50; 50; 50
      Line Style:
        Line Width: 0.02
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/RobotModel
      Name: MyCobot
      Enabled: true
      Value: true
      Description Topic:
        Value: /robot_description
      TF Prefix: ""
      Update Rate: 0
      Show Arrows: false
      Show Axes: false
      Show Names: false
      Visual Enabled: true
      Collision Enabled: false

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.3
      Update Interval: 0
      Frame Timeout: 15

    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Value: true
      Topic:
        Value: /vision_debug
      Queue Size: 2
      Transport Hint: raw

    - Alpha: 0.6
      Class: rviz_default_plugins/RobotModel
      Name: Collector
      Enabled: true
      Description Topic:
        Value: /robot_description

  Global Options:
    Background Color: 13; 17; 23
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Enable Stereo Rendering: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0.3
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.4
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.8
Window Geometry:
  Camera:
    collapsed: false
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
  X: 100
  Y: 100
