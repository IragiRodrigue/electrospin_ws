<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="electrospin_lab">

    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Scene -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.05 0.05 0.1 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Lab overhead light -->
    <light type="point" name="lab_light">
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.6 0.6 0.65 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Lab workbench -->
    <model name="workbench">
      <static>true</static>
      <pose>0 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 0.8 0.04</size>
            </box>
          </geometry>
        </collision>
        <visual name="top">
          <geometry>
            <box>
              <size>1.2 0.8 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Safety enclosure (transparent walls) -->
    <model name="safety_enclosure">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <!-- Back wall -->
        <visual name="back">
          <pose>0 -0.5 0.6 0 0 0</pose>
          <geometry>
            <box>
              <size>1.2 0.01 1.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.4 0.3</ambient>
            <diffuse>0.3 0.4 0.5 0.3</diffuse>
          </material>
        </visual>
        <!-- Left wall -->
        <visual name="left">
          <pose>-0.6 0 0.6 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 1.0 1.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.4 0.3</ambient>
            <diffuse>0.3 0.4 0.5 0.3</diffuse>
          </material>
        </visual>
        <!-- Right wall -->
        <visual name="right">
          <pose>0.6 0 0.6 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 1.0 1.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.4 0.3</ambient>
            <diffuse>0.3 0.4 0.5 0.3</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- High voltage power supply (visual only) -->
    <model name="hv_supply">
      <static>true</static>
      <pose>-0.4 0.3 0.44 0 0 0</pose>
      <link name="link">
        <visual name="body">
          <geometry>
            <box>
              <size>0.15 0.25 0.12</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.15 1</ambient>
            <diffuse>0.15 0.15 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Syringe pump (visual only) -->
    <model name="syringe_pump">
      <static>true</static>
      <pose>0.4 0.3 0.44 0 0 0</pose>
      <link name="link">
        <visual name="body">
          <geometry>
            <box>
              <size>0.1 0.2 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
