<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="electrospin_lab">

    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <gravity>0 0 -9.81</gravity>
    </physics>

    <!-- Scene -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.05 0.05 0.1 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- Sun -->
    <light type="directional" name="sun">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Lab overhead light -->
    <light type="point" name="lab_light">
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.6 0.6 0.65 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>1</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Lab workbench -->
    <model name="workbench">
      <static>1</static>
      <pose>0 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.4 0.9 0.04</size>
            </box>
          </geometry>
        </collision>
        <visual name="top">
          <geometry>
            <box>
              <size>1.4 0.9 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Safety enclosure (transparent walls) -->
    <model name="safety_enclosure">
      <static>1</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="back_collision">
          <pose>0 -0.5 0.6 0 0 0</pose>
          <geometry><box><size>1.4 0.01 1.2</size></box></geometry>
        </collision>
        <visual name="back">
          <pose>0 -0.5 0.6 0 0 0</pose>
          <geometry><box><size>1.4 0.005 1.2</size></box></geometry>
          <material><ambient>0.2 0.3 0.4 0.3</ambient><diffuse>0.3 0.4 0.5 0.3</diffuse></material>
        </visual>
        <collision name="left_collision">
          <pose>-0.7 0 0.6 0 0 0</pose>
          <geometry><box><size>0.01 1.0 1.2</size></box></geometry>
        </collision>
        <visual name="left">
          <pose>-0.7 0 0.6 0 0 0</pose>
          <geometry><box><size>0.005 1.0 1.2</size></box></geometry>
          <material><ambient>0.2 0.3 0.4 0.3</ambient><diffuse>0.3 0.4 0.5 0.3</diffuse></material>
        </visual>
        <collision name="right_collision">
          <pose>0.7 0 0.6 0 0 0</pose>
          <geometry><box><size>0.01 1.0 1.2</size></box></geometry>
        </collision>
        <visual name="right">
          <pose>0.7 0 0.6 0 0 0</pose>
          <geometry><box><size>0.005 1.0 1.2</size></box></geometry>
          <material><ambient>0.2 0.3 0.4 0.3</ambient><diffuse>0.3 0.4 0.5 0.3</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════════
         DIGITAL TWIN: Peristaltic Pump
         Visual model with rotating roller head.
         Physics and ROS2 topics handled by digital_twin_bridge node.
    ═══════════════════════════════════════════════════════════════════════ -->
    <model name="peristaltic_pump">
      <pose>0.35 0.25 0.46 0 0 0</pose>
      <link name="pump_base">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <mass>2.5</mass>
          <inertia>
            <ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.012</iyy><iyz>0</iyz><izz>0.008</izz>
          </inertia>
        </inertial>
        <collision name="body_collision">
          <geometry><box><size>0.12 0.10 0.10</size></box></geometry>
        </collision>
        <visual name="body">
          <geometry><box><size>0.12 0.10 0.10</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.25 1</ambient>
            <diffuse>0.25 0.25 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="head_housing">
          <pose>0 0 0.06 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.04</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.15 0.2 1</ambient>
            <diffuse>0.2 0.2 0.25 1</diffuse>
          </material>
        </visual>
        <visual name="display">
          <pose>0.061 0 0.02 0 1.5708 0</pose>
          <geometry><box><size>0.04 0.001 0.03</size></box></geometry>
          <material>
            <ambient>0.0 0.15 0.0 1</ambient>
            <diffuse>0.0 0.2 0.05 1</diffuse>
            <emissive>0.0 0.3 0.05 1</emissive>
          </material>
        </visual>
      </link>

      <!-- Rotating roller head -->
      <link name="pump_roller">
        <pose>0 0 0.06 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0001</iyy><iyz>0</iyz><izz>0.00005</izz>
          </inertia>
        </inertial>
        <visual name="roller_hub">
          <geometry><cylinder><radius>0.015</radius><length>0.035</length></cylinder></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="roller1">
          <pose>0.025 0 0 0 0 0</pose>
          <geometry><cylinder><radius>0.006</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <visual name="roller2">
          <pose>-0.0125 0.0217 0 0 0 0</pose>
          <geometry><cylinder><radius>0.006</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <visual name="roller3">
          <pose>-0.0125 -0.0217 0 0 0 0</pose>
          <geometry><cylinder><radius>0.006</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>

      <joint name="pump_roller_joint" type="revolute">
        <parent>pump_base</parent>
        <child>pump_roller</child>
        <pose>0 0 0.06 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <!-- Tubing -->
      <link name="pump_tubing">
        <visual name="tube">
          <pose>-0.15 0 0.02 0 0 0.3</pose>
          <geometry><cylinder><radius>0.003</radius><length>0.35</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.1 0.15 1</ambient>
            <diffuse>0.15 0.15 0.2 0.8</diffuse>
          </material>
        </visual>
      </link>
      <joint name="tubing_joint" type="fixed">
        <parent>pump_base</parent>
        <child>pump_tubing</child>
      </joint>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════════
         DIGITAL TWIN: Collector Drum with Motor
         Rotating cylinder with motor dynamics.
         Physics and ROS2 topics handled by digital_twin_bridge node.
    ═══════════════════════════════════════════════════════════════════════ -->
    <model name="collector_drum">
      <pose>-0.25 0.0 0.46 0 0 0</pose>
      <link name="collector_base_link">
        <inertial>
          <mass>3.0</mass>
          <inertia>
            <ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.02</iyy><iyz>0</iyz><izz>0.01</izz>
          </inertia>
        </inertial>
        <collision name="base_collision">
          <geometry><box><size>0.12 0.08 0.03</size></box></geometry>
        </collision>
        <visual name="base">
          <geometry><box><size>0.12 0.08 0.03</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
        <visual name="motor_housing">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.15 0.2 1</ambient>
            <diffuse>0.2 0.2 0.25 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Rotating drum -->
      <link name="drum_link">
        <pose>0 0 0.035 0 0 0</pose>
        <inertial>
          <mass>0.8</mass>
          <inertia>
            <ixx>0.003</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.003</iyy><iyz>0</iyz><izz>0.0015</izz>
          </inertia>
        </inertial>
        <collision name="drum_collision">
          <geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
        </collision>
        <visual name="drum">
          <geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
          <material>
            <ambient>0.35 0.35 0.4 1</ambient>
            <diffuse>0.4 0.4 0.45 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
        <visual name="mark1">
          <pose>0.04 0 0 0 0 0</pose>
          <geometry><box><size>0.001 0.002 0.06</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <visual name="mark2">
          <pose>-0.04 0 0 0 0 0</pose>
          <geometry><box><size>0.001 0.002 0.06</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>

      <joint name="drum_rotation_joint" type="revolute">
        <parent>collector_base_link</parent>
        <child>drum_link</child>
        <pose>0 0 0.035 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════════
         DIGITAL TWIN: High Voltage Power Supply
         Visual model with status LED and cable.
         Physics and ROS2 topics handled by digital_twin_bridge node.
    ═══════════════════════════════════════════════════════════════════════ -->
    <model name="hv_power_supply">
      <pose>-0.45 0.25 0.46 0 0 0</pose>
      <static>1</static>
      <link name="hv_base">
        <collision name="body_collision">
          <geometry><box><size>0.18 0.28 0.14</size></box></geometry>
        </collision>
        <visual name="body">
          <geometry><box><size>0.18 0.28 0.14</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.15 1</ambient>
            <diffuse>0.15 0.15 0.2 1</diffuse>
          </material>
        </visual>
        <visual name="panel">
          <pose>0.091 0 0 0 1.5708 0</pose>
          <geometry><box><size>0.24 0.001 0.12</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.08 1</ambient>
            <diffuse>0.08 0.08 0.12 1</diffuse>
          </material>
        </visual>
        <visual name="voltage_display">
          <pose>0.092 0.05 0.02 0 1.5708 0</pose>
          <geometry><box><size>0.06 0.001 0.03</size></box></geometry>
          <material>
            <ambient>0.0 0.1 0.0 1</ambient>
            <diffuse>0.0 0.15 0.0 1</diffuse>
            <emissive>0.0 0.25 0.0 1</emissive>
          </material>
        </visual>
        <visual name="status_led">
          <pose>0.092 -0.08 0.04 0 1.5708 0</pose>
          <geometry><sphere><radius>0.005</radius></sphere></geometry>
          <material>
            <ambient>0.5 0.0 0.0 1</ambient>
            <diffuse>0.8 0.0 0.0 1</diffuse>
            <emissive>0.3 0.0 0.0 1</emissive>
          </material>
        </visual>
        <visual name="hv_cable">
          <pose>0.05 -0.1 0.07 0.3 0 0.5</pose>
          <geometry><cylinder><radius>0.004</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.15 0.0 1</ambient>
            <diffuse>0.2 0.2 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════════
         DIGITAL TWIN: Environmental Sensors
         Temperature + Humidity sensor module.
         Physics and ROS2 topics handled by digital_twin_bridge node.
    ═══════════════════════════════════════════════════════════════════════ -->
    <model name="env_sensor">
      <pose>0.5 -0.3 0.44 0 0 0</pose>
      <static>1</static>
      <link name="sensor_base">
        <visual name="body">
          <geometry><box><size>0.04 0.025 0.015</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.2 1</ambient>
            <diffuse>0.2 0.2 0.25 1</diffuse>
          </material>
        </visual>
        <visual name="probe">
          <pose>0 0 0.012 0 0 0</pose>
          <geometry><cylinder><radius>0.004</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════════
         DIGITAL TWIN: Fiber Deposition Visual
         Simulates nanofiber deposition on collector surface.
    ═══════════════════════════════════════════════════════════════════════ -->
    <model name="fiber_deposition">
      <pose>-0.25 0.0 0.50 0 0 0</pose>
      <static>1</static>
      <link name="deposition_layer">
        <visual name="fibers">
          <geometry><cylinder><radius>0.038</radius><length>0.001</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.9 0.95 0.3</ambient>
            <diffuse>0.95 0.95 1.0 0.4</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Syringe on pump -->
    <model name="syringe">
      <pose>0.35 0.25 0.56 0 0 0</pose>
      <static>1</static>
      <link name="syringe_body">
        <visual name="barrel">
          <geometry><cylinder><radius>0.012</radius><length>0.08</length></cylinder></geometry>
          <material>
            <ambient>0.7 0.7 0.75 0.8</ambient>
            <diffuse>0.8 0.8 0.85 0.8</diffuse>
          </material>
        </visual>
        <visual name="plunger">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><cylinder><radius>0.01</radius><length>0.03</length></cylinder></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
        <visual name="needle">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><cylinder><radius>0.002</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.7 0.7 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
